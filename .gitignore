# macOS / editor metadata
.DS_Store
._*
*.swp

# Local dependencies and package-manager logs
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment and secrets (keep a shareable template if one is added)
.env
.env.*
!.env.example

# Test output, coverage and disposable caches
/tools/shots/*
!/tools/shots/.gitkeep
/coverage/
/.cache/
/.tmp/
/tmp/
*.log

# Internal content-maintenance workspace
/content/
/scripts/
/.work/
/drafts/
/demos/
/outputs/
/public/
/doc-fetch-resources/

# Local authorization screenshots
/*auth*.png
/*permission*.png
/lark-*.png

# README only needs the current cover and author cards
/assets/screenshots/

# Keep only media referenced by the current public snapshot. Referenced files
# are force-added to Git; stale downloads and original video masters stay local.
/site/media/*
