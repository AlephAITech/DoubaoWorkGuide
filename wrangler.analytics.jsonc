{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doubao-analytics-preview",
  "main": "analytics/worker.mjs",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".work/analytics/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*", "/privacy*"],
    "not_found_handling": "none"
  },
  "vars": {
    "ENVIRONMENT": "local",
    "LOCAL_TEST": "true",
    "ALLOWED_HOSTS": "localhost,127.0.0.1",
    "MAX_REQUESTS_PER_MINUTE": "1200",
    "MAX_EVENTS_PER_MINUTE": "300",
    "MAX_EVENTS_PER_DAY": "5000"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "doubao-analytics-preview",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "migrations"
  }],
  "durable_objects": {"bindings": [{"name": "TRAFFIC_GATE", "class_name": "TrafficGate"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["TrafficGate"]}],
  "triggers": {"crons": ["25 19 * * *"]},
  "observability": {"enabled": false}
}
